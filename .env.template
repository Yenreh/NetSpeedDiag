# NetSpeedDiag settings. Copy to .env and adjust.

# Dashboard bind address (no authentication: keep it on localhost)
NSD_HOST=127.0.0.1
NSD_PORT=7072

# Contracted plan in Mbps (0 = unknown, disables the plan comparison)
NSD_PLAN_DOWNLOAD_MBPS=0
NSD_PLAN_UPLOAD_MBPS=0

# Profile used when none is given (quick | standard | full, see config/tests.json)
NSD_DEFAULT_PROFILE=standard

# Paths (relative to the project root)
NSD_TESTS_FILE=config/tests.json
# Optional machine-specific overrides merged on top (not versioned), e.g. private SSH hosts
NSD_LOCAL_TESTS_FILE=config/tests.local.json
NSD_RESULTS_DIR=data/results
NSD_LOG_FILE=logs/netspeeddiag.log
NSD_LOG_LEVEL=INFO
